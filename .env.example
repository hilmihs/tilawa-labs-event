# --- Database (credentials live on the server only, never in a CI variable group)
DATABASE_URL=

# --- Signing secret for e-ticket tokens: openssl rand -base64 32
AUTH_SECRET=

# --- Salt for hashing IPs in the access log: openssl rand -base64 32
IP_SALT=

# --- Access codes. Three separate codes, never one.
KODE_PETUGAS=
KODE_PANITIA=
KODE_ADMIN=

# --- Bearer token so other dashboards can pull data
EXPORT_TOKEN=

# --- Only read by `pnpm db:seed`: the slug of the programme the seed creates or
# --- refreshes. The running app never reads it — programmes come from the table.
ACARA_SLUG=student-lecture
NEXT_PUBLIC_BASE_URL=https://example.org

# --- WhatsApp groups, split because one group caps at 1024 members
NEXT_PUBLIC_WA_GRUP_IKHWAN=
NEXT_PUBLIC_WA_GRUP_AKHWAT=

# --- Admin number shown to participants who get stuck
NEXT_PUBLIC_WA_ADMIN=""

# --- Registrations allowed per IP per hour. Tens, not a handful: a whole campus can
# --- sit behind one address. The real guard against a flood is the unique index on
# --- the WhatsApp number, not this. Raise it further while testing with a group who
# --- all share one office connection.
BATAS_DAFTAR_PER_IP=30

# --- Failed ticket lookups allowed per IP, and the window in minutes. Same shared
# --- address problem: too low and a few mistyped numbers lock out everyone on the
# --- same wifi.
BATAS_TIKET_GAGAL_PER_IP=20
BATAS_TIKET_JENDELA_MENIT=10

# --- How many proxies of our own sit in front of the app. The client address is
# --- counted this many hops from the RIGHT of X-Forwarded-For; the left end is
# --- whatever the client sent. 1 for a single nginx or Vercel, 2 with a CDN too.
PROXY_HOPS=1

# --- Connections per process. Left unset it is 12 on a container and 1 on a
# --- serverless platform, which is what you want in both cases.
# DB_POOL_MAX=

# --- The WhatsApp group links and the admin number below are only a fallback now.
# --- Once the site is up, set them in /admin instead — no redeploy needed.

# --- Email for account codes (password reset, email verification) goes through
# --- SendGrid over HTTPS — no SMTP host, port or password anywhere. `palsu` keeps the
# --- message in memory and prints it to the dev console.
# --- Unset: palsu outside production, sendgrid in production.
EMAIL_DRIVER=palsu
SENDGRID_API_KEY=
EMAIL_DARI="NAWA <admin@nawaroom.id>"
